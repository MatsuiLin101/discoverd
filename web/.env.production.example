# ⚠️ Copy this file to `.env.production` and replace every placeholder before going
# live. At minimum change: CADDY_ACME_EMAIL (a real address), POSTGRES_PASSWORD,
# the password inside DATABASE_URL / DIRECT_URL, JWT_SECRET (`openssl rand -hex 32`),
# SEED_ADMIN_PASSWORD, and all R2_* credentials. Never commit `.env.production`.

# Caddy
APP_DOMAIN=discoveredtravelgo.tw
# Use a real mailbox you control; Let's Encrypt sends expiry notices here.
CADDY_ACME_EMAIL=admin@example.com

# PostgreSQL container
POSTGRES_USER=discovered
POSTGRES_PASSWORD=change-this-long-random-password
POSTGRES_DB=discovered

# App database URLs. Keep host as `db` when using docker-compose.prod.yml.
DATABASE_URL=postgresql://discovered:change-this-long-random-password@db:5432/discovered
DIRECT_URL=postgresql://discovered:change-this-long-random-password@db:5432/discovered

# App
NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://discoveredtravelgo.tw
JWT_SECRET=change-this-with-openssl-rand-hex-32
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=change-this-before-first-seed

# Admin panel URL prefix — secret path the admin panel is served under so it
# can't be guessed (the plain /admin route returns 404). Runtime var, loaded via
# env_file: change it and `docker compose restart app`, no rebuild needed. Must
# NOT collide with a public route. Falls back to /admin if unset.
ADMIN_PATH=/console-change-me

# Storage
STORAGE_DRIVER=r2
STORAGE_PUBLIC_BASE_URL=https://files.discoveredtravelgo.tw
NEXT_PUBLIC_STORAGE_PUBLIC_BASE_URL=https://files.discoveredtravelgo.tw

# Cloudflare R2 (S3-compatible)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=discovered
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com

# Local storage fallback. Leave empty for R2 production.
LOCAL_STORAGE_DIR=

# Gmail
GMAIL_USER=youraddress@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Google Tag Manager
NEXT_PUBLIC_GTM_ID=

# GA4 Data API — powers the admin dashboard analytics panel (leave blank to hide).
# Service account (Analytics Data API enabled) added as Viewer on the GA4 property.
# GA4_PROPERTY_ID is the numeric property ID, not the G-XXXX measurement ID.
GA4_PROPERTY_ID=
GA_SA_CLIENT_EMAIL=
GA_SA_PRIVATE_KEY=

# AI encryption key — encrypts the shared AI API keys stored in the DB.
# Generate a 32-byte key: openssl rand -hex 32
AI_ENCRYPTION_KEY=

# Google Cloud API key for the Cloud Billing Pricing API (public SKUs need no
# IAM, just an API key with the Cloud Billing API enabled). Used to sync Gemini
# token prices from the admin panel / scripts/sync-gemini-prices.ts.
GOOGLE_CLOUD_API_KEY=
