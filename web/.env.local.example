# Ports (change to avoid conflicts with other local projects)
PORT=3000
DB_PORT=5432
DB_STUDIO_PORT=5555

# Database
# Local Docker (npm run db:up)
DATABASE_URL=postgresql://postgres:postgres@localhost:${DB_PORT}/discovered_dev
DIRECT_URL=postgresql://postgres:postgres@localhost:${DB_PORT}/discovered_dev
# Production (Supabase) — uncomment and replace the two lines above when deploying
# DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
# DIRECT_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres

# JWT — generate a long random string: openssl rand -hex 32
JWT_SECRET=

# Seed — initial admin account created by `npm run db:seed`
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=password

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Gmail (email notifications) — use a Google App Password, not your real password
# Generate at: Google Account → Security → 2-Step Verification → App passwords
GMAIL_USER=youraddress@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# App
NEXT_PUBLIC_APP_URL=http://localhost:${PORT}

# Google Tag Manager — fill in your GTM container ID to enable tracking
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX
