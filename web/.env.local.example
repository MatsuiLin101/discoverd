# Ports (change to avoid conflicts with other local projects)
PORT=3000
DB_PORT=5432
DB_STUDIO_PORT=5555

# Database
# Local Docker (npm run db:up)
DATABASE_URL=postgresql://postgres:postgres@localhost:${DB_PORT}/discovered_dev
DIRECT_URL=postgresql://postgres:postgres@localhost:${DB_PORT}/discovered_dev
# Production (Supabase) — uncomment and replace the two lines above when deploying
# DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
# DIRECT_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres

# JWT — generate a long random string: openssl rand -hex 32
JWT_SECRET=

# Seed — initial admin account created by `npm run db:seed`
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=password

# Storage
STORAGE_DRIVER=r2                      # r2 | local；本機開發可留空，會自動 fallback 到本機磁碟
STORAGE_PUBLIC_BASE_URL=https://files.yourdomain.com
NEXT_PUBLIC_STORAGE_PUBLIC_BASE_URL=https://files.yourdomain.com  # 供 next.config 取得圖片網域

# Cloudflare R2 (S3-compatible)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=discovered
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com

# Local driver（僅 STORAGE_DRIVER=local 時使用；留空則寫入 public/uploads 並以相對路徑提供）
LOCAL_STORAGE_DIR=

# Gmail (email notifications) — use a Google App Password, not your real password
# Generate at: Google Account → Security → 2-Step Verification → App passwords
GMAIL_USER=youraddress@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# App
NEXT_PUBLIC_APP_URL=http://localhost:${PORT}

# Google Tag Manager — fill in your GTM container ID to enable tracking
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX
