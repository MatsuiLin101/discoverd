generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  STAFF
}

model User {
  id          String        @id @default(cuid())
  username    String        @unique
  displayName String        @unique
  email       String?
  password    String
  role        Role          @default(STAFF)
  sessions    Session[]
  logs        ActivityLog[]
  importLogs  ImportLog[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

// One session per user (userId unique → same account is single-device; a new login
// replaces the previous one). Different accounts each have their own session and coexist.
model Session {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Region {
  id                String      @id @default(cuid())
  name              String      @unique
  slug              String      @unique
  // Frozen 3-digit business code (101+), assigned once; reordering never changes it.
  code              String?     @unique
  thumbnailKey      String?
  seoTitle          String?
  seoDescription    String?
  ogImageKey        String?
  sortOrder         Int         @default(0)
  subRegions        SubRegion[]
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
}

model SubRegion {
  id                String   @id @default(cuid())
  regionId          String
  region            Region   @relation(fields: [regionId], references: [id], onDelete: Cascade)
  name              String
  slug              String
  // Frozen 2-digit business code (01+) within the parent region; reordering never changes it.
  code              String?
  thumbnailKey      String?
  seoTitle          String?
  seoDescription    String?
  ogImageKey        String?
  sortOrder         Int      @default(0)
  tours             Tour[]
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([regionId, slug])
  @@unique([regionId, code])
}

model Tag {
  id        String @id @default(cuid())
  name      String @unique
  sortOrder Int    @default(0)
  tours     Tour[] @relation("TourTags")
}

model Tour {
  id                String     @id @default(cuid())
  subRegionId       String
  subRegion         SubRegion  @relation(fields: [subRegionId], references: [id], onDelete: Restrict)
  name              String
  slug              String     @unique
  // Frozen 13-digit product id: regionCode(3)+subCode(2)+YYMMDD(6,UTC+8)+dailySeq(2).
  // Assigned once at creation; moving to another subRegion never recomputes it.
  productId         String?    @unique
  thumbnailKey      String?
  price             Int
  description       String?
  seoTitle          String?
  seoDescription    String?
  ogImageKey        String?
  tags              Tag[]      @relation("TourTags")
  files             TourFile[]
  published         Boolean    @default(true)
  sortOrder         Int        @default(0)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
}

// Plan A: uploaded PDF or image files stored via the storage abstraction (R2 / local)
model TourFile {
  id        String   @id @default(cuid())
  tourId    String
  tour      Tour     @relation(fields: [tourId], references: [id], onDelete: Cascade)
  key       String
  mimeType  String
  filename  String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
}


// Sales team info: regions are simple named, drag-sortable buckets; each holds
// business-card files (agents) that only need an uploaded image/PDF, no fields.
model SalesRegion {
  id        String       @id @default(cuid())
  name      String       @unique
  sortOrder Int          @default(0)
  agents    SalesAgent[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

model SalesAgent {
  id        String      @id @default(cuid())
  regionId  String
  region    SalesRegion @relation(fields: [regionId], references: [id], onDelete: Cascade)
  cardKey   String
  mimeType  String
  filename  String?
  sortOrder Int         @default(0)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

enum LogAction {
  CREATE
  UPDATE
  DELETE
  REORDER
  LOGIN
  LOGOUT
}

enum LogResource {
  REGION
  SUB_REGION
  TAG
  TOUR
  TOUR_FILE
  AUTH
  HERO_BANNER
  SITE_SETTING
  SALES_REGION
  SALES_AGENT
  IMPORT
}

model HeroBanner {
  id            String   @id @default(cuid())
  title         String
  imageKey      String
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model SiteSetting {
  id               String   @id @default("singleton")
  facebookUrl      String?
  instagramUrl     String?
  lineUrl          String?
  lineCommunityUrl String?
  updatedAt        DateTime @updatedAt
}

model ActivityLog {
  id           String      @id @default(cuid())
  userId       String?
  user         User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  userAccount  String
  action       LogAction
  resource     LogResource
  resourceId   String
  resourceName String
  detail       Json?
  createdAt    DateTime    @default(now())
}

enum ImportModule {
  TAG
  REGION
  TOUR
}

enum ImportStatus {
  PENDING
  COMMITTED
}

// Excel import staging + audit. A preview writes a PENDING row holding the
// normalised rows (payload); committing applies them and flips to COMMITTED.
// The md5 lets us warn on byte-identical re-uploads.
model ImportLog {
  id           String       @id @default(cuid())
  module       ImportModule
  filename     String
  md5          String
  status       ImportStatus @default(PENDING)
  payload      Json         // normalised rows, used by the token-based commit
  summary      Json         // preview summary: created/updated/skipped/errors/duplicates
  createdCount Int          @default(0)
  updatedCount Int          @default(0)
  skippedCount Int          @default(0)
  userId       String?
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt    DateTime     @default(now())
  committedAt  DateTime?
}
