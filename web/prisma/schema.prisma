generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  STAFF
}

model User {
  id          String        @id @default(cuid())
  username    String        @unique
  displayName String        @unique
  email       String?
  password    String
  role        Role          @default(STAFF)
  sessions    Session[]
  logs        ActivityLog[]
  importLogs  ImportLog[]
  aiPreference   UserAiPreference?
  aiGenerations  AiGeneration[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

// One session per user (userId unique → same account is single-device; a new login
// replaces the previous one). Different accounts each have their own session and coexist.
model Session {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Region {
  id                String      @id @default(cuid())
  name              String      @unique
  slug              String      @unique
  // Frozen 3-digit business code (101+), assigned once; reordering never changes it.
  code              String?     @unique
  thumbnailKey      String?
  // Crop rect over the original thumbnail, normalized 0..1: { x, y, w, h }. 16:9.
  thumbnailCrop     Json?
  seoTitle          String?
  seoDescription    String?
  ogImageKey        String?
  sortOrder         Int         @default(0)
  subRegions        SubRegion[]
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
}

model SubRegion {
  id                String   @id @default(cuid())
  regionId          String
  region            Region   @relation(fields: [regionId], references: [id], onDelete: Cascade)
  name              String
  slug              String
  // Frozen 2-digit business code (01+) within the parent region; reordering never changes it.
  code              String?
  thumbnailKey      String?
  // Crop rect over the original thumbnail, normalized 0..1: { x, y, w, h }. 16:9.
  thumbnailCrop     Json?
  seoTitle          String?
  seoDescription    String?
  ogImageKey        String?
  sortOrder         Int      @default(0)
  tours             Tour[]
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([regionId, slug])
  @@unique([regionId, code])
}

model Tag {
  id        String @id @default(cuid())
  name      String @unique
  sortOrder Int    @default(0)
  tours     Tour[] @relation("TourTags")
}

model Tour {
  id                String     @id @default(cuid())
  subRegionId       String
  subRegion         SubRegion  @relation(fields: [subRegionId], references: [id], onDelete: Restrict)
  name              String
  slug              String     @unique
  // Frozen 13-digit product id: regionCode(3)+subCode(2)+YYMMDD(6,UTC+8)+dailySeq(2).
  // Assigned once at creation; moving to another subRegion never recomputes it.
  productId         String?    @unique
  thumbnailKey      String?
  // Crop rect over the original thumbnail, normalized 0..1: { x, y, w, h }. 4:3.
  thumbnailCrop     Json?
  price             Int
  description       String?
  seoTitle          String?
  seoDescription    String?
  ogImageKey        String?
  tags              Tag[]      @relation("TourTags")
  files             TourFile[]
  aiGenerations     AiGeneration[]
  published         Boolean    @default(true)
  sortOrder         Int        @default(0)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
}

// Plan A: uploaded PDF or image files stored via the storage abstraction (R2 / local)
model TourFile {
  id        String   @id @default(cuid())
  tourId    String
  tour      Tour     @relation(fields: [tourId], references: [id], onDelete: Cascade)
  key       String
  mimeType  String
  filename  String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
}


// Sales team info: regions are simple named, drag-sortable buckets; each holds
// business-card files (agents) that only need an uploaded image/PDF, no fields.
model SalesRegion {
  id        String       @id @default(cuid())
  name      String       @unique
  sortOrder Int          @default(0)
  agents    SalesAgent[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

model SalesAgent {
  id        String      @id @default(cuid())
  regionId  String
  region    SalesRegion @relation(fields: [regionId], references: [id], onDelete: Cascade)
  cardKey   String
  mimeType  String
  filename  String?
  sortOrder Int         @default(0)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

enum LogAction {
  CREATE
  UPDATE
  DELETE
  REORDER
  LOGIN
  LOGOUT
}

enum LogResource {
  REGION
  SUB_REGION
  TAG
  TOUR
  TOUR_FILE
  AUTH
  HERO_BANNER
  SITE_SETTING
  SALES_REGION
  SALES_AGENT
  IMPORT
  AI_SETTING
  AI_GENERATION
}

model HeroBanner {
  id            String   @id @default(cuid())
  title         String
  imageKey      String
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model SiteSetting {
  id               String   @id @default("singleton")
  facebookUrl      String?
  instagramUrl     String?
  lineUrl          String?
  lineCommunityUrl String?
  // Site-wide layout mode:
  //   "original" — full-bleed site; carousel is desktop full-bleed cover and
  //                mobile follows mobileHeroRatio.
  //   "fit"      — full-bleed site; carousel shows the whole image at full
  //                width keeping its natural ratio, capped at heroMaxHeight px.
  //   "boxed"    — the whole site (header, body, footer) is centered within
  //                boxMaxWidth px; the carousel scales by ratio inside the box
  //                and boxOuterBackground fills the area beside the box.
  layoutMode         String   @default("original")
  // Whether auto-advance pauses while the pointer hovers the carousel.
  // (Keyboard-focus pause always stays on for accessibility.)
  heroPauseOnHover   Boolean  @default(true)
  // Max carousel height (px), used by the ratio modes ("fit" and "boxed").
  heroMaxHeight      Int      @default(720)
  // Carousel aspect ratio for the ratio modes ("fit" and "boxed"). "auto"
  // uses the first image's natural ratio; "2/1" | "16/9" | "3/2" | "4/3" |
  // "1/1" force a fixed ratio (the image is contained within it).
  heroRatio          String   @default("auto")
  // Box width (px) and the background beside it, used only by "boxed".
  boxMaxWidth        Int      @default(1280)
  boxOuterBackground String   @default("neutral") // "neutral" | "gradient" | "dark"
  // Mobile hero fit for the "original" mode: "cover" keeps the full-bleed
  // crop; "2/1", "4/3", "1/1" switch to a fixed aspect-ratio container that
  // contains the whole image. Desktop always stays full-bleed cover.
  mobileHeroRatio    String   @default("cover")

  // --- AI 生成設定（全站共用）---------------------------------------------
  // API 金鑰以 AES-256-GCM 加密後存放，永不回傳明文給前端。
  geminiApiKeyEnc     String?
  manusApiKeyEnc      String?
  // 系統預設模型與提示詞範本；個人偏好（UserAiPreference）可覆蓋。
  // 範本為 null 時改用程式內建的預設字串（見 src/lib/ai/prompts.ts）。
  aiDescriptionModel  String   @default("gemini-3.6-flash")
  aiDescriptionPrompt String?
  aiThumbnailPrompt   String?

  updatedAt          DateTime @updatedAt
}

model ActivityLog {
  id           String      @id @default(cuid())
  userId       String?
  user         User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  userAccount  String
  action       LogAction
  resource     LogResource
  resourceId   String
  resourceName String
  detail       Json?
  createdAt    DateTime    @default(now())
}

enum ImportModule {
  TAG
  REGION
  TOUR
}

enum ImportStatus {
  PENDING
  COMMITTED
}

// Excel import staging + audit. A preview writes a PENDING row holding the
// normalised rows (payload); committing applies them and flips to COMMITTED.
// The md5 lets us warn on byte-identical re-uploads.
model ImportLog {
  id           String       @id @default(cuid())
  module       ImportModule
  filename     String
  md5          String
  status       ImportStatus @default(PENDING)
  payload      Json         // normalised rows, used by the token-based commit
  summary      Json         // preview summary: created/updated/skipped/errors/duplicates
  createdCount Int          @default(0)
  updatedCount Int          @default(0)
  skippedCount Int          @default(0)
  userId       String?
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt    DateTime     @default(now())
  committedAt  DateTime?
}

// Per-user overrides for AI generation. Any field left null falls back to the
// system default stored on SiteSetting (and then to the built-in default).
model UserAiPreference {
  id                String   @id @default(cuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  descriptionModel  String?
  descriptionPrompt String?
  thumbnailPrompt   String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

enum AiGenerationKind {
  DESCRIPTION
  THUMBNAIL
}

enum AiGenerationStatus {
  PENDING // Manus thumbnail task in flight; poll for the result
  READY   // usable candidate (description text, or a stored thumbnail image)
  FAILED  // generation errored; `error` holds the reason
}

// Saved AI candidates per tour so editors can regenerate several times and pick
// their favourite. Capped at 5 per (tour, kind) in the API; never auto-pruned.
model AiGeneration {
  id          String             @id @default(cuid())
  tourId      String
  tour        Tour               @relation(fields: [tourId], references: [id], onDelete: Cascade)
  kind        AiGenerationKind
  status      AiGenerationStatus @default(READY)
  text        String?            // DESCRIPTION: generated intro text
  imageKey    String?            // THUMBNAIL: stored image key (R2 / local)
  taskId      String?            // THUMBNAIL: Manus task id while PENDING
  error       String?            // FAILED: reason
  model       String?            // model / agent profile actually used
  prompt      String?            // the prompt actually sent, for reference
  isSelected  Boolean            @default(false)
  createdById String?
  createdBy   User?              @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime           @default(now())

  @@index([tourId, kind])
}
